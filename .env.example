# Copy this file to .env and fill in your keys.

# ── Cloud Gemma (escalation path) ────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMMA_API_KEY=
GEMMA_CLOUD_MODEL=gemma-4-27b-it

# ── Anthropic Vision (Claude Sonnet 4.6) ─────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
# Used for vision_query route. Leave blank to use on-device Gemma for vision.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# ── ElevenLabs TTS ───────────────────────────────────────────────────────────
# Get a key at https://elevenlabs.io — free tier works fine for personal use.
# Leave blank to use Apple AVSpeechSynthesizer fallback.
ELEVENLABS_API_KEY=
# Optional: override default voice (Adam). Browse voices at elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=

# ── Desktop Relay ─────────────────────────────────────────────────────────────
# URL of your laptop running desktop-relay/index.js
# Use your Tailscale IP for cross-network (recommended):
#   RELAY_URL=http://100.x.x.x:7878
# Use local LAN IP if always on same wifi:
#   RELAY_URL=http://192.168.1.x:7878
RELAY_URL=
# Must match RELAY_SECRET in desktop-relay/.env
RELAY_SECRET=change-me-to-a-random-string
