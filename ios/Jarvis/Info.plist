<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Jarvis</string>
  <key>CFBundleIdentifier</key>
  <string>com.jarvis.app</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>

  <!-- Camera permission required by Meta DAT -->
  <key>NSCameraUsageDescription</key>
  <string>Jarvis needs camera access to stream video from your Ray-Ban glasses.</string>

  <!-- Microphone permission required by Meta DAT -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Jarvis needs microphone access to capture audio from your Ray-Ban glasses.</string>

  <!-- Bluetooth required to communicate with glasses -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Jarvis uses Bluetooth to connect to your Meta Ray-Ban glasses.</string>
  <key>NSBluetoothPeripheralUsageDescription</key>
  <string>Jarvis uses Bluetooth to connect to your Meta Ray-Ban glasses.</string>

  <!-- Meta Wearables DAT analytics opt-out (optional) -->
  <key>MWDAT</key>
  <dict>
    <key>Analytics</key>
    <dict>
      <key>OptOut</key>
      <false/>
    </dict>
  </dict>
</dict>
</plist>
