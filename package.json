{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ios": "react-native run-ios --device",
    "start": "react-native start",
    "bundle:ios": "react-native bundle --entry-file=index.js --platform=ios --dev=false --bundle-output=ios/main.jsbundle --assets-dest=ios --reset-cache",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run test:build && node --test test/*.test.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-voice/voice": "^3.2.4",
    "cactus-react-native": "^0.1.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-dotenv": "^3.4.11",
    "react-native-fs": "^2.20.0",
    "react-native-nitro-modules": "^0.20.0",
    "react-native-permissions": "^4.1.5",
    "react-native-sound": "^0.11.2",
    "react-native-tts": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/react": "^18.3.0",
    "@types/react-native": "^0.73.0",
    "eslint": "^8.19.0",
    "patch-package": "^8.0.1",
    "typescript": "5.0.4"
  }
}
