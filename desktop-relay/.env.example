# Copy to .env and fill in.

# Shared secret — must match RELAY_SECRET in the iPhone app's .env
RELAY_SECRET=change-me-to-a-random-string

# Port the relay listens on (default 7878)
RELAY_PORT=7878

# Google AI Studio key for Gemma 4 — same key as GEMMA_API_KEY in the app's .env
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
